{
    "manifest_version": 3,
    "name": "RobotClass Cleaner",
    "version": "1.0",
    "description": "Удаляет ненужные поля на сайте robotclass.ru по запросу",
    "action": {
      "default_title": "Очистить robotclass.ru"
    //   "default_icon": {
    //     "16": "icons/icon16.png",
    //     "32": "icons/icon32.png",
    //     "48": "icons/icon48.png"
    //   }
    },
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["*://robotclass.ru/*"],
    // "icons": {
    //   "16": "icons/icon16.png",
    //   "32": "icons/icon32.png",
    //   "48": "icons/icon48.png",
    //   "128": "icons/icon128.png"
    // },
    "background": {
      "service_worker": "background.js"
    }
  }